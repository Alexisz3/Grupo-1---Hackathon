# Escuela Semilla · configuración. Copiar a .env (nunca subir .env al repo).
# Toda la IA corre local en Docker: no hace falta ninguna clave. Guía: docs/docker.md

# ── Texto con IA (Ollama) ──
# gemma3:4b  → probado, ~6-10 s por página en CPU, ~4 GB de RAM (por defecto)
# gemma4:e4b → más nuevo y mejor (texto + imágenes + herramientas), ~10 GB de descarga; medirlo con: ./scripts/escuela.sh bench
# gemma4:26b → el más potente que cabe en 32 GB (MoE, ~18 GB), pero lento en CPU para usar en vivo
OLLAMA_MODEL=gemma3:4b

# ── Ilustraciones ──
# stabilityai/sd-turbo   → rápido (~8 s por imagen), ~4 GB de RAM (por defecto)
# stabilityai/sdxl-turbo → mejor calidad, ~3 veces más lento, ~10 GB de RAM
PAINTER_MODEL=stabilityai/sd-turbo

# ── Modo dividido (la app en AWS y la IA en la PC del equipo) ──
# En la PC: ./scripts/escuela.sh ia crea AI_TOKEN y muestra AI_URL.
# En AWS: pegar aquí esas dos líneas y correr ./scripts/escuela.sh app
# AI_URL=https://xxxx.trycloudflare.com
# AI_TOKEN=

# ── Red ──
# 127.0.0.1 = solo esta computadora. 0.0.0.0 = visible en la red (servidor o EC2).
APP_BIND=127.0.0.1
APP_PORT=3000

# ── Solo si se corre sin Docker (pnpm start) ──
# MODEL_URL=http://127.0.0.1:11434/v1/chat/completions
# MODEL_NAME=gemma3:4b
# TTS_URL=http://127.0.0.1:8880/v1/audio/speech
# IMAGE_URL=http://127.0.0.1:7860/generate
