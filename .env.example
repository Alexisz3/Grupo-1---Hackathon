# Escuela Semilla · configuración. Copiar a .env (nunca subir .env al repo: lleva claves).
# Guía: docs/docker.md

# ── Texto con IA (cuentos, Pipo, personajes de historia, describir dibujos) ──
# Elegir UNA opción.
#
# Opción A · Gemini (rápido, ~2 s por página). Clave gratis en https://aistudio.google.com/apikey
MODEL_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
MODEL_NAME=gemini-3.5-flash-lite
MODEL_EFFORT=low
MODEL_KEY=
#
# Opción B · Ollama local, sin clave (más lento en CPU: ~6-10 s por página). Levantar con --ollama y usar:
# MODEL_URL=http://ollama:11434/v1/chat/completions
# MODEL_NAME=gemma3:4b
# MODEL_EFFORT=
# MODEL_KEY=

# ── Voz ──
# En Docker la voz local (Kokoro) ya viene configurada. GEMINI_KEY es solo el respaldo (3 audios por minuto gratis).
GEMINI_KEY=
TTS_MODEL=gemini-3.8-flash-tts

# ── Ilustraciones ──
# En Docker el ilustrador local (SD-Turbo) ya viene configurado.
# IMAGE_MODEL sirve solo si la clave de Gemini tiene cuota de imágenes (planes pagos).
IMAGE_MODEL=

# ── Red ──
# 127.0.0.1 = solo esta computadora. 0.0.0.0 = visible en la red (servidor o EC2).
APP_BIND=127.0.0.1
APP_PORT=3000

# ── Solo si se corre sin Docker (pnpm start) ──
# TTS_URL=http://127.0.0.1:8880/v1/audio/speech
# IMAGE_URL=http://127.0.0.1:7860/generate
